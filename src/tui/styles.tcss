/* Палитра-токены TUI MVP — §2.4 спеки.
 * Принцип: цвет — редкий сигнал, тело монохромно; смысл несут ASCII-глифы.
 *
 * Значения цветов ($bg, $code, $ok, …) НЕ определяются здесь — единый источник
 * tui/palette.py, инжектится через TuiApp.get_css_variables(). Правка цвета —
 * только в palette.py (там же Python-рендер берёт те же токены).
 */

Screen {
    background: $bg;
    color: $ink;
}

/* Шапка / подвал — тихие хром-полосы */
#header { height: 2; background: $bg; color: $deep-dim;
          padding: 0 1; border-bottom: solid $deep-dim; }
#header-left  { width: 1fr; color: $deep-dim; }
#header-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }
#footer { height: 2; background: $bg; color: $dim;
          padding: 0 1; }
#diff-status { height: 1; background: $bg; color: $accent;
               content-align: left middle; padding: 0 1; }
#footer-left  { width: 1fr; color: $dim; }
#footer-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }

/* Контентная зона трейса. Разделитель снизу даёт border-top у #input-row —
 * свой border-bottom не ставим, иначе две линии подряд (раньше между ними
 * стояла #meta, теперь её нет). */
/* #trace по умолчанию заполняет доступную высоту и скроллится (read-only экраны:
 * preview/viewer/help/config/mcp/tool_call_detail переиспользуют id="trace"). */
#trace { height: 1fr; padding: 0 1; background: $bg; }
/* Скроллбар — ЕДИНЫЙ стиль для всех скроллируемых контейнеров (трейс, /sessions,
 * /skills, read-only экраны): узкий и тихий, фирменный teal только при наведении/
 * перетаскивании (акцент — редкий сигнал). Тип-селектор → одинаково везде. */
VerticalScroll {
    scrollbar-size: 1 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $deep-dim;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}
/* Только на главном экране #trace — auto: сжимается до контента, хром ниже
 * (индикатор/ввод/футер) следует за концом контента (Claude-style), пустота —
 * внизу под футером. Потолок (max-height) ставится из кода = экран минус хром,
 * чтобы при заполнении экрана #trace скроллился, а не выдавливал ввод/футер. */
TraceScreen #trace { height: auto; }
/* Докнутая статус-строка индикатора — вне скролла #trace (стрим не накладывается).
 * Высота по умолчанию 2 (пустой старт без задачи: [отступ][индикатор-место]).
 * При активной задаче код поднимает до 3 (_sync_indicator_reserve): добавляется
 * нижняя строка-отступ — индикатор отделён и от трейса, и от поля ввода.
 * В пределах состояния высота фиксирована → нет «прыжка». */
#indicator-bar { height: 2; padding: 0 1; background: $bg; }

/* Brand-блок — постоянная шапка трейса (Claude-style: стартовый экран = начало
 * трейса; ниже flow'ом индикатор загрузки MCP и далее диалог; не скрывается). */
#brand-block {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 1 2;
    border: round $accent;
}

/* Поле ввода — Claude-style: две тонкие линии ─ над и под input.
 * `>` flush-left на первой строке; ввод многострочный (TextArea),
 * растёт по высоте, continuation-строки выровнены отступом prompt'а. */
#input-row {
    height: auto;                       /* растёт с контентом */
    min-height: 3;                      /* 1 content + top + bottom border */
    width: 1fr;
    padding: 0;
    background: $bg;
    border-top: solid $deep-dim;
    border-bottom: solid $deep-dim;
}
#input-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left top; padding: 0; }
#cmdinput {
    height: auto;                       /* растёт со строками */
    max-height: 10;                     /* потолок; дальше — скролл */
    width: 1fr;
    border: none;
    padding: 0;
    background: $bg;
    color: $ink;
    scrollbar-size: 0 0;
}
#cmdinput:focus { border: none; }
#cmdinput > .text-area--cursor { background: $accent; color: $bg; }

/* /sessions фильтр — стиль как у главного input */
#sessions-filter-row {
    height: 3;
    width: 1fr;
    padding: 0;
    background: $bg;
    border-top: solid $deep-dim;
    border-bottom: solid $deep-dim;
}
#sessions-filter-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left middle; padding: 0; }
#sessions-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
#sessions-filter:focus { border: none; }

/* FOCUS-2px — на НЕ-ввод (трейс/список/футер), когда Tab уведёт фокус туда */
#trace:focus, .list-row:focus, #footer:focus { outline: solid $accent; }

/* Фокус строки события — сдвиг-безопасная подсветка фона (заменила [N]-префикс:
   background не рефлоунит контент, в отличие от prefix/border). */
ToolCallRow:focus, TraceRow:focus, UserReplyContainer:focus, AgentReplyLine:focus {
    background: $focus-bg;
}

/* TraceRow — 2-колоночный layout (prefix фиксированной ширины + content width:1fr) */
.trace-prefix  { width: auto; height: auto; padding: 0; }
.trace-content { width: 1fr;  height: auto; padding: 0; }

/* Типы строк трейса */
.line-user      { color: $ink; }       /* текст реплики; маркер > отдельно */
.line-user-mark { color: $accent; }    /* маркер > */
.line-agent     { color: $ink; margin-top: 1; }  /* ● реплика агента; отступ — фазы хода */
/* Continuation prose-виджеты внутри одной agent-реплики — без top-margin
   (spec 2026-05-26 / code-block-highlight): первый prose-блок получает
   margin-top:1, остальные — 0, чтобы избежать двойных отступов внутри реплики. */
.line-agent-cont { margin-top: 0; }
.table-block { width: 1fr; margin: 1 0; }
.table-block.table-indent { margin-left: 2; }  /* трейс/превью: вровень с текстом реплики (как код-панели) */

/* Fenced code-block panel (spec 2026-05-26 / code-block-highlight):
   Claude-style панель с фоном $band-bg, подсветка через rich.syntax. */
.code-block-panel {
    background: $band-bg;
    padding: 0 1;
    margin-top: 1;
    height: auto;
    width: 1fr;
}
.code-block-panel.code-indent { margin-left: 2; }  /* трейс/превью: вровень с текстом реплики; баннер — без отступа */

/* spec 2026-05-27 / tool-output-detail */
.detail-section-header {
    height: 1;
    margin-top: 1;
    width: 1fr;
}
.detail-section-rule {
    color: $deep-dim;
    width: 1fr;
    height: 1;
}
.detail-section-label {
    color: $deep-dim;
    width: auto;
    height: 1;
    padding: 0 1;
}

.line-tool      { color: $dim; }       /* |- механика тула */
/* Первый tool в группе (предыдущий ряд — не tool) отделён верхним отступом;
   подряд идущие tool-строки компактны (класс вешается в коде — Textual CSS
   не умеет «соседний элемент»). */
ToolCallRow.tool-group-start { margin-top: 1; }
.line-think     { color: $muted; text-style: italic; margin-top: 1; }
.line-intermediate { color: $ink; margin-top: 1; }  /* ·-реплика — фаза хода, как ● */
.ask-human-question.hidden { display: none; }  /* вопрос скрыт, пока виден баннер */
.answered-question { border: round $frame-archive; color: $dim; padding: 0 1; margin: 1 0; width: 1fr; }
.answered-question.hidden { display: none; }
.line-error     { color: $err; }
.line-code      { color: $code; }      /* inline-код/путь */
.line-bold      { color: $accent; text-style: bold; }
.line-heading-1 { color: $accent; text-style: bold; }
.line-heading-2 { color: $accent; text-style: bold; }      /* вес легче — render-A */
.line-block     { color: $code-block; }
.line-ok        { color: $ok; }
.line-run       { color: $run-color; }
.line-meta      { color: $deep-dim; margin-top: 1; }
.line-bang      { color: $run-color; margin-top: 1; }
.line-bang-out  { color: $dim; }
.line-bang-fail { color: $err; }
.skill-marker   { margin: 1 0; }  /* top И bottom: margin-bottom один перетирал margin-top от .line-meta → не было зазора над [skill] */
.line-note      { color: #a5adb8; margin-top: 1; }  /* чуть светлее $dim; пустая строка сверху — отделяет ремарку; курсив — только на тексте ремарки (см. note_text), ярлык прямой */
.summary-marker { color: $deep-dim; margin: 1 0; }  /* пустая строка сверху И снизу — маркер обособлен */
.summary-body   { color: $dim; margin-bottom: 1; }
.summary-body.hidden { display: none; }

/* Подложка реплики пользователя (§2.6) */
.user-band {
    background: #282c36;   /* чуть светлее $band-bg — реплика контрастнее в трейсе; темнее $focus-bg (фокус различим) */
    border-left: outer $accent;
    padding: 0 1 0 1;
    /* Только верхний отступ — общая конвенция трейса (разделение «через margin-top
     * следующего элемента»). Нижний отступ убран: он складывался с margin-top
     * индикатора через границу контейнеров (#trace ↔ #indicator-bar, где margin
     * не схлопывается) и давал 2 пустые строки перед индикатором. */
    margin: 1 0 0 0;
    height: auto;
    width: 1fr;
}

/* Pending: приглушённая teal-кромка (spec 2026-05-26) */
.user-band.user-reply-pending {
    border-left: outer #3a7a72;
}

/* Failed: красная кромка + инлайн [!] (spec 2026-05-26) */
.user-band.user-reply-failed {
    border-left: outer #C75C54;
}

/* Бренд-блок пустого состояния (§2.8) */
.brand-logo { color: $brand; text-style: bold; width: auto; height: auto; }
.brand-tagline { color: $dim; width: auto; height: auto; margin-top: 1; }
#brand-left { width: auto; height: auto; }
#brand-row { width: 1fr; height: auto; }
#brand-mcp  { width: 1fr; color: $deep-dim; padding-left: 6; height: auto; content-align: left top; }

/* ThinkingIndicator — «думаю…» (spec 2026-05-26) */
/* padding слева = 0: глиф встаёт по колонке буллетов ●/> строк трейса
   (.trace-prefix padding:0); правый отступ 1 сохраняем. */
.thinking-indicator { color: $deep-dim; padding: 0 1 0 0; margin-top: 1; height: 1; }
.thinking-indicator.hidden { display: none; }

/* StreamBlock — эфемерный in-progress поток текущего шага (chat_completions) */
/* левый padding 0 — выравнивание с индикатором и колонкой буллетов трейса. */
.stream-block { color: $ink; padding: 0 1 0 0; margin-top: 1; }
.stream-block-think { color: $muted; text-style: italic; }

/* Палитра команд (overlay, Task 3.3) */
.palette       { background: #161A23; border: round $run-color; height: auto; max-height: 80%; }
.palette-row   { color: $ink; padding: 0 1; }
/* $focus-bg, не $band-bg: фон оверлея (#161A23) почти совпадает с $band-bg —
   выделение было слепым; focus-bg = подсветка фокуса в трейсе, заметно светлее. */
.palette-row.selected { background: $focus-bg; color: $bright; }
.palette-hint  { color: $deep-dim; padding: 0 1; }
.palette-keys  { margin-top: 1; }   /* воздух перед строкой клавиш — как .set-hint */

/* Toggle-подвал палитры (/gate, /answers — спека 2026-07-16 §4): докнут вне скролла. */
.palette-footer     { dock: bottom; height: auto; }
.palette-separator  { color: $deep-dim; padding: 0 1; height: 1; margin: 0; }

/* Строки HelpScreen — реестр команд + доп. хоткеи */
.help-section  { color: $deep-dim; padding: 0 1; }
.help-row      { height: auto; width: 1fr; color: $ink; }
.help-row.help-row-alt { background: #181c26; }  /* зебра: чуть светлее фона для читаемости */
.help-row-main { width: 1fr; padding-left: 1; }
.help-row-key  { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }

/* Тело ViewerScreen — read-only payload/файл */
.viewer-body   { color: $ink; padding: 0 1; }
/* FileViewerScreen: TextArea(read_only) — скролл, syntax, мышиное выделение */
FileViewerScreen #root { height: 1fr; }
#file-view-body {
    height: 1fr;
    width: 1fr;
    border: none;
    padding: 0 1;
    background: $bg;
    color: $ink;
}
#file-view-body:focus { border: none; }

/* Строки списков (TasksScreen, SkillsScreen) */
.list-row      { color: $ink; padding: 0 1; }

/* ask_human banner (§3.4) — янтарный тон (как running), сигнал «жду тебя».
 * max-height: длинный вопрос скроллится внутри (VerticalScroll), не выдавливает
 * input/footer. Точный потолок дополнительно ставит _sync_trace_max_height. */
.ask-human-banner {
    background: #161A23;
    border: round $run-color;
    padding: 0 1;
    margin: 0 1;
    height: auto;
    max-height: 50%;
    width: 1fr;
}
.ah-label { color: $bright; text-style: bold; }
.ah-body  { color: $ink; }
/* input в режиме ask_human — янтарная рамка (как баннер / running) */
TextArea.ask-human-mode { border: solid $run-color; }

/* confirm banner — служебный/security, бирюзовый (accent) вместо янтарного.
 * max-height как у ask_human: длинные fields не выдавливают футер. */
.confirm-banner {
    background: #161A23;
    border: round $accent;
    padding: 0 1;
    margin: 0 1;
    height: auto;
    max-height: 50%;
    width: 1fr;
}
.cb-label    { color: $bright; text-style: bold; }
.cb-question { color: $ink; }
.cb-field    { color: $dim; }
.cb-options  { color: $accent; }

/* скрытый input-row при confirm (одиночные клавиши y/N без TextArea) */
#input-row.hidden { display: none; }

/* SessionsScreen — picker недавних задач (Task 4.1) */
#sessions-root { height: 100%; }
#sessions-header { height: 2; background: #161A23; color: $deep-dim;
                 border-bottom: solid $deep-dim; padding: 0 1; }
#sessions-header-left  { width: 1fr; color: $deep-dim; }
#sessions-header-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }
#sessions-footer { height: 1; padding: 0 1; }
#sessions-footer-left  { width: 1fr; color: $dim; }
#sessions-footer-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }
#sessions-list { height: 1fr; }
#sessions-list Static { padding: 0 1; }
#sessions-list .card { height: auto; margin-bottom: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#sessions-list .card.selected { background: $card-select-bg; border-left: outer $accent; }

/* PreviewScreen — read-only превью сессии (футер с линией-разделителем) */
#preview-footer { height: 2; background: #161A23; color: $dim;
                  border-top: solid $deep-dim; padding: 0 1; }

/* SkillsScreen — picker, двустрочные карточки (2026-06-02) */
#skills-root { height: 100%; }
#skills-filter-row { height: 3; width: 1fr; padding: 0; background: $bg; border-top: solid $deep-dim; border-bottom: solid $deep-dim; }
#skills-filter-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left middle; padding: 0; }
#skills-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
#skills-filter:focus { border: none; }
#skills-list { height: 1fr; }
#skills-list Static { padding: 0 1; }
#skills-list .card { height: auto; margin-bottom: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#skills-list .card.selected { background: $card-select-bg; border-left: outer $accent; }

/* McpScreen — карточки серверов (spec 2026-06-10) */
.mcp-card { height: auto; padding: 0 1; margin-bottom: 1; }
.mcp-card:focus { background: $card-select-bg; border-left: outer $accent; }
.mcp-summary { padding: 0 1; }
.mcp-confirm { background: $band-bg; border-left: outer $warn; padding: 0 1; }
.mcp-row { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }   /* описание обрезается … */

/* ConfigScreen — fieldset-панели (spec 2026-06-10) */
.config-caption { color: $dim; padding: 0 1; margin: 0 0 1 0; }
.config-panel {
    height: auto;
    border: round $deep-dim;
    border-title-color: $dim;
    border-subtitle-color: $deep-dim;
    padding: 0 1;
    margin: 0 0 1 0;
}
/* read-only вьюверы: фокус-outline бессмыслен (фокусироваться больше не на чем)
   и рисуется поверх контента */
#trace.quiet-focus:focus { outline: none; }
/* строка фильтра ключей конфига — в той же конвенции, что #skills-filter */
#config-filter-row { height: 3; width: 1fr; padding: 0; background: $bg; border-top: solid $deep-dim; border-bottom: solid $deep-dim; }
#config-filter-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left middle; padding: 0; }
#config-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }

/* ── Онбординг ─────────────────────────────────────────── */
/* Хедер (титул) сверху + футер (подсказки, слева) снизу — как на основном экране;
   teal-карточка (лого+тэглайн+степпер+шаг) — контент между ними, по размеру. */
#onb-header { height: 2; background: $bg; color: $deep-dim; padding: 0 1; border-bottom: solid $deep-dim; }
#header-left { width: 1fr; color: $deep-dim; }
#onb-scroll { height: auto; max-height: 100%; padding: 0; background: $bg; }
#onb-footer { height: 2; background: $bg; color: $dim; padding: 0 1; }
#onb-frame { height: auto; width: 1fr; border: round $accent; padding: 1 2; margin: 1 1; background: $bg; }
#onb-logo { height: auto; padding: 0; }
#onb-tagline { height: auto; color: $deep-dim; margin-top: 1; padding: 0; }
#onb-stepper { height: auto; padding: 2 0; }
#onb-summary { height: 1; margin-bottom: 1; }   /* строка сводки — клип по краю, без переноса; воздух перед заголовком шага */
#onb-body { height: auto; padding: 0; margin-bottom: 1; }   /* воздух под заголовком шага (как #set-title) */
/* Поля ввода — плоские, как #config-filter (без дефолтной рамки Input, что мусорит box-символами). */
#onb-endpoint, #onb-token, #onb-model, #conn-url, #conn-token { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
#onb-endpoint:focus, #onb-token:focus, #onb-model:focus, #conn-url:focus, #conn-token:focus { border: none; background: $band-bg; }
.onb-option { height: auto; padding: 0 1; width: 1fr; }
/* Выбор — только фон, БЕЗ border-left: полоса сдвигала контент на 1 колонку,
   отчего кружки ●/○ в /settings-секциях съезжали друг относительно друга. */
.onb-option.selected { background: $focus-bg; }   /* контраст как у палитры/трейса */
.onb-mcp-row { text-wrap: nowrap; text-overflow: ellipsis; }
.set-spaced { margin-bottom: 1; }   /* воздух между строками-опциями в /settings-секциях */
/* Первая строка-действие: зазор сверху (от инфо-строк) И снизу (между действиями) одним
   shorthand — раздельные longhand'ы .set-gap+.set-spaced на одном элементе Textual перетирает
   (последний .set-gap обнулял margin-bottom → пропадал воздух под первым действием). */
.set-spaced-gap { margin: 1 0 1 0; }
.auth-nested { margin-left: 4; }
.onb-hint { color: $deep-dim; padding: 0; }
.set-group-gap { margin-top: 1; }   /* отступ между группами секции (Адрес ↔ Авторизация) */
.onb-warn { color: $warn; padding: 0; }
#config-filter:focus { border: none; }

/* Поле фильтра моделей — паттерн /sessions: «> » (accent) + плоский Input, без amber-рамки. */
.model-filter-row { height: 1; width: 1fr; margin-bottom: 1; }
.model-filter-prompt { width: 2; color: $accent; height: 1; }
.model-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
.model-filter:focus { border: none; background: $band-bg; }

/* /settings — хаб настроек (визуальный контракт §2-3; идиомы = onb-*) */
#set-header { height: 2; background: $bg; color: $deep-dim; padding: 0 1; border-bottom: solid $deep-dim; }
#set-scroll { height: auto; max-height: 100%; padding: 0; background: $bg; }
#set-footer { height: 2; background: $bg; color: $dim; padding: 0 1; }
#set-frame { height: auto; width: 1fr; border: round $accent; padding: 1 2; margin: 1 1; background: $bg; }
/* Единая левая граница контента = padding 0 1 у ВСЕХ элементов секции/меню
   (frame даёт +2, элементы +1 → всё на 3 от рамки; рассинхрон отступов был
   причиной «адрес левее / авторизация поехала»). */
#set-title { height: auto; padding: 0 1; margin-bottom: 1; }   /* воздух под заголовком */
/* Строка меню — горизонтальная раскладка: текст слева (1fr) + глиф статуса
   у правого края. Так глиф не «едет» при выборе и не липнет к значению. */
.set-menurow { height: auto; layout: horizontal; padding: 0 1; margin-bottom: 1; }
.set-menurow.selected { background: $focus-bg; }   /* контраст как у палитры/трейса */
.set-rowtext { width: 1fr; height: auto; text-wrap: nowrap; text-overflow: ellipsis; }
.set-glyph { width: 3; height: auto; text-align: right; }
.set-row { height: auto; padding: 0 1; }
.set-row.selected { background: $focus-bg; }   /* контраст как у палитры/трейса */
.set-hint { color: $deep-dim; padding: 0 1; margin-top: 1; }   /* воздух перед контекст-подсказкой */
.set-info { height: auto; padding: 0 1; }   /* инфо-строки (Версия/Источник) — тот же отступ */
/* Подписи редакторов (Модель/Подключение) несут .onb-hint/.onb-warn из онбординга
   (padding 0) — в /settings выравниваем их на ту же границу 3, что заголовок и опции.
   Онбординг (#onb-frame) селектор не задевает — там своя раскладка. */
#set-frame .onb-hint, #set-frame .onb-warn { padding: 0 1; }
.set-gap { margin-top: 1; }                 /* вертикальный зазор между смысловыми группами */
.set-warnflash { color: $warn; }
.set-probe { margin-top: 1; }               /* воздух перед строкой статуса probe */

/* Пост-апдейт (D4) — карточка по контенту, как #set-frame (визуальный контракт §6);
   раньше сидел в #trace{height:1fr} и раскатывался на весь пустой экран. */
#pu-scroll { height: auto; max-height: 100%; padding: 0; background: $bg; }
#pu-frame { height: auto; width: 1fr; border: round $accent; padding: 1 2; margin: 1 1; background: $bg; }
.pu-title { height: auto; padding: 0 0 1 0; border-bottom: solid $deep-dim; margin-bottom: 1; }
.pu-title.solo { padding: 0; border-bottom: none; margin-bottom: 0; }   /* нечего обновлять — линии под заголовком нет */
.post-update-hint { height: auto; color: $deep-dim; padding: 0; }
.post-update-item { height: auto; padding: 0; }
.set-confirm { background: $band-bg; border-left: outer $warn; padding: 0 1; margin-top: 1; }
.set-flash-ok   { background: $band-bg; border-left: outer $ok;   padding: 0 1; margin-top: 1; color: $ok; }
.set-flash-warn { background: $band-bg; border-left: outer $warn; padding: 0 1; margin-top: 1; color: $warn; }
#set-notice { margin-top: 1; }              /* отделить notice (итог install/удаления) от контента над ним */
/* Поле ввода в /settings — скруглённая amber-рамка (id+class специфичнее flat
   #onb-* → онбординг остаётся без рамки, как принят). */
#onb-endpoint.set-framed, #onb-token.set-framed, #onb-model.set-framed,
#conn-url.set-framed, #conn-token.set-framed {
    border: round $run-color; height: 3; width: 1fr; padding: 0 1; background: $bg;
}
#onb-endpoint.set-framed:focus, #onb-token.set-framed:focus, #onb-model.set-framed:focus,
#conn-url.set-framed:focus, #conn-token.set-framed:focus {
    border: round $run-color; background: $band-bg;
}

/* Редакторы полей — Vertical по дефолту height:1fr и растягивают рамку;
   принудительно height:auto, чтобы рамка (#onb-frame/#set-frame) обнимала контент. */
EndpointEditor, AuthEditor, ModelEditor, McpSectionEditor, ConnectionEditor { height: auto; }
