# Copy to litellm/.env and fill in real values.
# litellm/run.py reads this file on startup via os.environ.
#
# GigaChat: base64(client_id:client_secret) from https://developers.sber.ru/studio/
export GIGACHAT_CREDENTIALS=

# Yandex Cloud AI Studio API key from https://console.cloud.yandex.ru/
export YANDEX_API_KEY=

# Yandex Cloud folder ID (e.g. b1gxxxxxxxxxxxxxxxxxx), required for the
# yandex-gpt-* aliases — see Service accounts → Folder in the cloud console.
export YANDEX_FOLDER_ID=

# OpenRouter API key from https://openrouter.ai/
export OPENROUTER_API_KEY=
