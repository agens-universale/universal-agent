# Скопируйте в litellm/.env и заполните реальными значениями.
# litellm/run.py читает этот файл на старте через os.environ.
#
# GigaChat: base64(client_id:client_secret) из https://developers.sber.ru/studio/
export GIGACHAT_CREDENTIALS=

# Yandex Cloud AI Studio API-ключ из https://console.cloud.yandex.ru/
export YANDEX_API_KEY=

# Yandex Cloud folder ID (например, b1gxxxxxxxxxxxxxxxxxx), нужен для алиасов
# yandex-gpt-* — найти можно на странице облака: Сервисные аккаунты → Папка.
export YANDEX_FOLDER_ID=

# OpenRouter API-ключ из https://openrouter.ai/
export OPENROUTER_API_KEY=
