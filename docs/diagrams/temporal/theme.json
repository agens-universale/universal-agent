{
  "theme": "base",
  "fontFamily": "Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#e9efff",
    "primaryTextColor": "#172d4a",
    "primaryBorderColor": "#526dae",
    "lineColor": "#475569",
    "secondaryColor": "#e8f5ed",
    "tertiaryColor": "#f4f6fa",
    "clusterBkg": "#f7f9fc",
    "clusterBorder": "#94a3b8",
    "actorBkg": "#e9efff",
    "actorBorder": "#526dae",
    "actorTextColor": "#172d4a",
    "signalColor": "#344862",
    "signalTextColor": "#172d4a",
    "noteBkgColor": "#fff4d6",
    "noteBorderColor": "#b18735",
    "noteTextColor": "#43351b"
  },
  "flowchart": {
    "htmlLabels": false,
    "useMaxWidth": false,
    "curve": "linear",
    "nodeSpacing": 32,
    "rankSpacing": 55,
    "padding": 16,
    "wrappingWidth": 420
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": true,
    "actorMargin": 38,
    "width": 185,
    "messageMargin": 32,
    "noteMargin": 15,
    "actorFontSize": 18,
    "messageFontSize": 16,
    "noteFontSize": 16,
    "mirrorActors": false
  }
}
