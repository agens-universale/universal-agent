/* Палитра-токены TUI MVP — §2.4 спеки.
 * Принцип: цвет — редкий сигнал, тело монохромно; смысл несут ASCII-глифы.
 *
 * Значения цветов ($bg, $code, $ok, …) НЕ определяются здесь — единый источник
 * tui/palette.py, инжектится через TuiApp.get_css_variables(). Правка цвета —
 * только в palette.py (там же Python-рендер берёт те же токены).
 */

Screen {
    background: $bg;
    color: $ink;
}

/* Шапка / подвал — тихие хром-полосы */
#header { height: 2; background: $bg; color: $deep-dim;
          padding: 0 1; border-bottom: solid $deep-dim; }
#header-left  { width: 1fr; color: $deep-dim; }
#header-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }
/* Высота подвала — auto с полом в две строки: пока подсказки влезают в строку,
   под ними остаётся привычный воздух, а на узком окне полоса растёт и переносит
   их ЦЕЛИКОМ. Фиксированная высота молча съедала хвост — «… · Esc» пропадал с
   экрана ровно там, где выход нужнее всего. Обрубок врёт о клавишах так же, как
   обрубок счётчиков в шапке, поэтому решение общее для всех read-only экранов. */
#footer { height: auto; min-height: 2; background: $bg; color: $dim;
          padding: 0 1; }
/* Исключение — главный экран: его подвал верстается кодом (усечение cwd,
   адаптивный стек usage) и стоит НАД полем ввода, где рост полосы двигал бы
   ввод под рукой. */
TraceScreen #footer { height: 2; }
/* padding-right: 2 — ФИЗИЧЕСКИЙ зазор между колонками футера. Правая колонка
   width:auto забирает своё по содержимому, левая (1fr) получает остаток — и без этих
   двух столбцов её текст упирался в имя модели вплотную (живая приёмка). Арифметика
   `_footer_right_available_width` про «≥1 пробел» решала только, сворачивать ли правую
   часть на вторую строку, и на раскладку колонок не влияла вовсе.
   Левая — две строки: режим и хвост команд (#footer-mode), под ними слот
   временного и бейджа (#footer-slot). Переноса нет: лишнее — многоточие. */
#footer-left  { width: 1fr; height: 2; color: $dim; padding-right: 2; }
#footer-mode, #footer-slot {
    height: 1; text-wrap: nowrap; text-overflow: ellipsis;
}
#footer-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }

/* Контентная зона трейса. Разделитель снизу даёт border-top у #input-row —
 * свой border-bottom не ставим, иначе две линии подряд (раньше между ними
 * стояла #meta, теперь её нет). */
/* #trace по умолчанию заполняет доступную высоту и скроллится (read-only экраны:
 * preview/viewer/help/config/mcp/tool_call_detail переиспользуют id="trace"). */
#trace { height: 1fr; padding: 0 1; background: $bg; }
/* Скроллбар — ЕДИНЫЙ стиль для всех скроллируемых контейнеров (трейс, /sessions,
 * /skills, read-only экраны): узкий и тихий, фирменный teal только при наведении/
 * перетаскивании (акцент — редкий сигнал). Тип-селектор → одинаково везде. */
VerticalScroll {
    scrollbar-size: 1 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $deep-dim;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}
/* Главный экран — тот же `1fr`: лента забирает всё над хромом, ввод и подвал
 * всегда прижаты к низу экрана (пустая сессия — пустота между бренд-карточкой и
 * вводом). Список из поля ввода встаёт над вводом и поднимает ленту.
 * Ширина — 100%, а не `1fr` по умолчанию: вертикальная раскладка Textual даёт
 * fr-детям ширину контейнера минус НАИБОЛЬШИЙ боковой margin соседей, и баннер
 * с `margin: 0 1` сужал ленту на две колонки.
 * Нижний зазор ленты — пустая строка над баром, баннером, списком или полем
 * ввода (S10). Полный шортхенд (частичный margin затирается); margin, а не
 * padding: дорожка скроллбара в ряд зазора не заходит. Общий #trace не
 * трогаем — его переиспользуют экраны только для чтения. */
TraceScreen #trace { width: 100%; margin: 0 0 1 0; }
/* Бар индикатора — вне скролла #trace (стрим не накладывается). Стоит только
 * во время работы открытого треда (класс -turn, _sync_indicator_bar): строка
 * индикатора и нижний ряд, на котором стоит плашка «в конец». Высота внутри
 * хода постоянна → нет «прыжка». */
#indicator-bar { display: none; height: 2; padding: 0 1; background: $bg; }
#indicator-bar.-turn { display: block; }

/* Brand-блок — постоянная шапка трейса (Claude-style: стартовый экран = начало
 * трейса; ниже flow'ом индикатор загрузки MCP и далее диалог; не скрывается). */
#brand-block {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 1 2;
    border: round $accent;
}

/* Поле ввода — Claude-style: две тонкие линии ─ над и под input.
 * `>` flush-left на первой строке; ввод многострочный (TextArea),
 * растёт по высоте, continuation-строки выровнены отступом prompt'а. */
#input-row {
    height: auto;                       /* растёт с контентом */
    min-height: 3;                      /* 1 content + top + bottom border */
    width: 1fr;
    padding: 0;
    background: $bg;
    border-top: solid $deep-dim;
    border-bottom: solid $deep-dim;
}
/* Запись голосом: оливковый бордер = «микрофон активен» (гаснет на стопе). */
#input-row.recording {
    border-top: solid $olive;
    border-bottom: solid $olive;
}
#input-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left top; padding: 0; }
#cmdinput {
    height: auto;                       /* растёт со строками */
    max-height: 10;                     /* потолок; дальше — скролл */
    width: 1fr;
    border: none;
    padding: 0;
    background: $bg;
    color: $ink;
    scrollbar-size: 0 0;
}
#cmdinput:focus { border: none; }
#cmdinput > .text-area--cursor { background: $accent; color: $bg; }

/* /sessions фильтр — стиль как у главного input */
#sessions-filter-row {
    height: 3;
    width: 1fr;
    padding: 0;
    background: $bg;
    border-top: solid $deep-dim;
    border-bottom: solid $deep-dim;
}
#sessions-filter-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left middle; padding: 0; }
#sessions-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
#sessions-filter:focus { border: none; }

/* FOCUS-2px — на НЕ-ввод (список/футер), когда Tab уведёт фокус туда.
   #trace здесь НЕТ, и это общее решение, а не правка одного экрана: `outline`
   в Textual места не резервирует, а рисуется ПОВЕРХ виджета — движок затирает
   им первую и последнюю строки (_styles_cache.render_line: y == 0 / height-1),
   а дети-строки закрашивают середину рамки собой. Живьём выходила разорванная
   рамка на КАЖДОМ экране, где фокус садится на #trace: список изменений,
   вьюер, подтверждение отката, /view, уведомления, превью, детали вызова и сам
   трейс главного экрана после Tab. База гасила это по месту трижды —
   help/mcp снимают фокус (can_focus = False), config — классом quiet-focus, —
   и все три раза с одной причиной в комментарии. Здесь причина снята разом:
   у прокручиваемого #trace рамки фокуса нет вовсе. Фокусируемым он остаётся —
   на нём держится клавиатурная прокрутка (↑↓ PgUp PgDn в футерах). */
.list-row:focus, #footer:focus { outline: solid $accent; }

/* Фокус строки события — сдвиг-безопасная подсветка фона (заменила [N]-префикс:
   background не рефлоунит контент, в отличие от prefix/border). */
ToolCallRow:focus, TraceRow:focus, UserReplyContainer:focus,
BlockPanel:focus, TodoBlock:focus {
    background: $highlight-bg;
}
/* DiffBlock здесь НЕТ: он не фокусируется вовсе (can_focus=False) — событие
   трейса это вызов инструмента, дифф лишь его часть, и Tab идёт по событиям. */

/* TraceRow — 2-колоночный layout (prefix фиксированной ширины + content width:1fr) */
.trace-prefix  { width: auto; height: auto; padding: 0; }
.trace-content { width: 1fr;  height: auto; padding: 0; }

/* Типы строк трейса */
.line-user      { color: $ink; }       /* текст реплики; маркер > отдельно */
.line-user-mark { color: $accent; }    /* маркер > */
.line-agent     { color: $ink; margin-top: 1; }  /* ● реплика агента; отступ — фазы хода */
/* Continuation prose-виджеты внутри одной agent-реплики — без top-margin
   (spec 2026-05-26 / code-block-highlight): первый prose-блок получает
   margin-top:1, остальные — 0, чтобы избежать двойных отступов внутри реплики. */
.line-agent-cont { margin-top: 0; }
/* Fenced code-block panel и markdown-таблица — общий виджет BlockPanel
   (структурная раскладка — в BlockPanel.DEFAULT_CSS, здесь только тема).
   ВАЖНО: отступы задаются ОДНИМ shorthand-правилом на класс. Textual не мёржит
   margin-* из разных правил — отдельное `margin-left` затирает весь box вместе
   с margin-top (эпизод 2026-08-04; такой же был с .set-gap/.set-spaced). */
.code-block-panel {
    background: $block-bg;
    padding: 0 1;
    margin: 1 0 1 0;
}
.code-block-panel.code-indent { margin: 1 0 1 2; }  /* трейс/превью: вровень с текстом реплики; баннер — без отступа */

.table-block {
    background: $block-bg;
    padding: 0 1;
    margin: 1 0 1 0;
}
.table-block.table-indent { margin: 1 0 1 2; }  /* трейс/превью: вровень с текстом реплики (как код-панели) */

/* Инлайн-дифф правки агента (раскладка — в DiffBlock.DEFAULT_CSS, здесь тема).
   Отступы — одним shorthand-правилом, как у панелей выше.
   В отличие от панелей блок НЕ карточка рядом, а следствие своей строки
   инструмента: прижат к ней без вертикальных отступов (зазор до следующего
   события даёт его собственный верхний отступ). Счётчики `(+a −r)` и
   кнопка ❐ — в самой строке вызова. Колонки ленты
   (trace_render.level_prefix): глиф
   события уровня n — в колонке `●` плюс 2n; следствие — на +2 от глифа своего
   события: левый отступ 2 у вызова агента, 4 — у вызова субагента (уровень 1);
   тело и хвост — с колонки блока. Подложки на самом блоке нет: тёмный фон
   несут только тело и хвост. */
.diff-block {
    padding: 0;
    margin: 0 0 0 2;
}
.diff-block.diff-nested { margin: 0 0 0 4; }  /* правка субагента (уровень 1) */
/* Дифф под блоком P4: колонка 2 (одиночная правка) или 4 (член блока) от
   глифа своего уровня; у субагента — на 2 глубже. */
.diff-block.diff-single { margin: 0 0 0 2; }
.diff-block.diff-member { margin: 0 0 0 4; }
.diff-block.diff-nested.diff-single { margin: 0 0 0 4; }
.diff-block.diff-nested.diff-member { margin: 0 0 0 6; }
.diff-block .block-body,
.diff-block .diff-more { background: $block-bg; }
.diff-more { color: $dim; }

/* Шапка блока: метка языка слева, кнопка копирования справа; та же кнопка ❐
   — в конце строки вызова с правкой (ToolCallRow). */
.block-label { color: $dim; }
.block-copy  { color: $dim; }
/* Наведение на действие ленты (❐, «… ещё N строк») — одно правило. */
.trace-action:hover { color: $accent; }

/* Накладки над лентой «не внизу» (спека P3 §2.6): поверх экрана, высоты
   ленты не занимают; место и ширину ставит код по #trace. Ховер плашки —
   светлее фон, цвет текста прежний: осознанное исключение из
   .trace-action:hover; так же и у StickyReply. */
StickyReply, ScrollEndPill {
    overlay: screen;
    position: absolute;
    height: 1;
    display: none;
}
StickyReply { background: $queue-bg; }
StickyReply:hover { background: $highlight-bg; }
ScrollEndPill { background: $user-band-bg; color: $ink; }
ScrollEndPill:hover { background: $highlight-bg; }

/* spec 2026-05-27 / tool-output-detail */
.detail-section-header {
    height: 1;
    margin-top: 1;
    width: 1fr;
}
.detail-section-rule {
    color: $deep-dim;
    width: 1fr;
    height: 1;
}
.detail-section-label {
    color: $deep-dim;
    width: auto;
    height: 1;
    padding: 0 1;
}

/* чек-лист session_todo — маркер фазы хода, как ● и ·: обособлен пустой строкой
   сверху. Только margin-top (общая конвенция трейса — разделение через отступ
   СЛЕДУЮЩЕГО элемента, см. UserReplyContainer); нижний дал бы двойной зазор перед тулами. */
.line-todo      { color: $ink; }        /* заголовок; воздух — на .todo-block */
.line-todo-nested { color: $dim; }      /* заголовок чек-листа субагента */
/* Воздух вокруг чек-листа — на блоке-контейнере: у основного только сверху
   (снизу отделяет отступ следующей фазы), у субагентского с обеих сторон —
   соседние nested-строки своих отступов не имеют. */
.todo-block        { margin-top: 1; }
.todo-block-nested { margin: 1 0; }
.line-tool      { color: $dim; }       /* |- механика тула */
/* Пустая строка перед каждым вызовом — верхним и вложенным (спека P3 §2.1). */
ToolCallRow { margin-top: 1; }
/* Блоки P4: члены и строки внутри блока субагента — без пустой строки
   сверху; между видимыми файлами блока правок — есть (спека P4 §3.1). */
ToolCallRow.-member, ToolCallRow.-in-agent { margin-top: 0; }
ToolCallRow.-gap { margin-top: 1; }
/* Внутри блока субагента пустых строк нет совсем (спека P4 §3.1, §7):
   ни перед событиями, ни между файлами правок. */
ToolCallRow.-in-agent.-gap { margin-top: 0; }
.line-intermediate.-in-agent { margin-top: 0; }
.todo-block-nested.-in-agent { margin: 0; }
/* Скрытое блоком: вне окна, ждущий вызов группы, скрытая фраза. */
.-block-hidden { display: none; }
/* Фразы блока: управляющие — MUTED (ховер — .trace-action:hover), строка
   незаписанных файлов — DIM. */
.block-action { color: $muted; }
.block-note { color: $dim; }
.line-think     { color: $muted; text-style: italic; margin-top: 1; }
.line-intermediate { color: $ink; margin-top: 1; }  /* промежуточная реплика — фаза хода */
/* Промежуточная реплика (основного агента и субагента): глиф `●` своего
   уровня — серым; белый `●` — у итогового ответа (спека P3 §10). */
.line-intermediate .trace-prefix { color: $dim; }
.ask-human-question.hidden { display: none; }  /* вопрос скрыт, пока виден баннер */
.answered-question { border: round $frame-archive; color: $dim; padding: 0 1; margin: 1 0; width: 1fr; }
.answered-question.hidden { display: none; }
.line-error     { color: $err; }
.line-warn      { color: $warn; }   /* строка `!` без владельца — предупреждение */
.line-standalone { margin-top: 1; }  /* строка `!` без владельца — своё событие */
.line-model { margin-top: 1; }  /* отметка смены модели — своё событие */
.line-code      { color: $code; }      /* inline-код/путь */
.line-bold      { color: $ink; text-style: bold; }
.line-heading-1 { color: $ink; text-style: bold; }
.line-heading-2 { color: $ink; text-style: bold; }      /* вес легче — render-A */
.line-block     { color: $code-block; }
.line-ok        { color: $ok; }
.line-run       { color: $run-color; }
.line-meta      { color: $deep-dim; margin-top: 1; }
.line-bang      { color: $run-color; margin-top: 1; }
.line-bang-out  { color: $dim; }
.line-bang-fail { color: $err; }
.line-note      { color: $note-ink; margin-top: 1; }  /* чуть светлее $dim; пустая строка сверху — отделяет ремарку; курсив — только на тексте ремарки (см. note_text), ярлык прямой */
/* Запись «* итог:» после ответа модели — цвет и отступ как у .line-note, текст курсивом (метка прямая — см. build_summary_widgets); проза после блока кода — без отступа сверху. Маркер «* » прямой, как у заметки. */
.line-summary   { color: $note-ink; margin-top: 1; text-style: italic; }
.line-summary .trace-prefix { text-style: not italic; }
.line-summary.line-agent-cont { margin-top: 0; }
/* Метка сжатия (спека P3 §2.5): цвета полос и подписи — в самой строке
   (`compaction_rule`); пустая строка сверху и снизу, у раскрытой — снизу
   отделяет уже тело. */
.summary-marker { margin: 1 0; }
.summary-marker.expanded { margin-bottom: 0; }
.summary-body   { color: $dim; margin-bottom: 1; }
.summary-body.hidden { display: none; }
.summary-body .compaction-content { width: 1fr; height: auto; }
.summary-body .compaction-head { color: $sub-ink; }

/* Реплика пользователя (спека P3 §2.2): маркер `›` в колонке `●`, подложка
   во всю ширину ленты без кромки; строки следствий `└` — под подложкой. */
UserReplyContainer {
    /* Только верхний отступ — общая конвенция трейса (разделение «через margin-top
     * следующего элемента»). Нижний отступ убран: он складывался с margin-top
     * индикатора через границу контейнеров (#trace ↔ #indicator-bar, где margin
     * не схлопывается) и давал 2 пустые строки перед индикатором. */
    margin: 1 0 0 0;
    height: auto;
    width: 1fr;
}
.user-band {
    background: $user-band-bg;   /* светлее $band-bg — реплика контрастнее в трейсе; темнее $highlight-bg (фокус различим) */
    padding: 0 1 0 0;
    height: auto;
    width: 1fr;
}
/* Реплика в очереди (P3 §2.4; «тихая реплика», как у StickyReply): тише подложка и текст; подсказка — под
   подложкой на фоне ленты, в колонке текста после `› `. Правило очереди —
   до правила фокуса: фокус его перекрывает. */
UserReplyContainer.-queued > .user-band {
    background: $queue-bg;
    color: $quiet-reply-ink;
}
UserReplyContainer:focus > .user-band { background: $highlight-bg; }
.queue-hint { display: none; height: auto; padding-left: 2; color: $muted; }
UserReplyContainer.-queue-hint > .queue-hint { display: block; }

/* Бренд-блок пустого состояния (§2.8) */
.brand-logo { color: $brand; text-style: bold; width: auto; height: auto; }
.brand-tagline { color: $dim; width: auto; height: auto; margin-top: 1; }
/* Версия — своей строкой под тэглайном, через отступ: вплотную она читалась
   как часть тэглайна. Тише его: это справка, а не часть бренда. */
.brand-version { color: $deep-dim; width: auto; height: auto; margin-top: 1; }
#brand-left { width: auto; height: auto; }
#brand-row { width: 1fr; height: auto; }
#brand-mcp  { width: 1fr; color: $deep-dim; padding-left: 6; height: auto; content-align: left top; }
/* Тот же блок, когда он под брендом (узкое окно): воздух сверху и левый край без
   отступа — под логотипом колонке не от чего отступать, отступ там читался как
   случайный сдвиг. Отдельным правилом, а не в шортхенде выше: per-side margin из
   разных правил Textual перетирает целиком. */
#brand-mcp.brand-mcp-stacked { margin-top: 1; padding-left: 0; }

/* ThinkingIndicator — «думаю…» (spec 2026-05-26) */
/* padding слева = 0: глиф встаёт по колонке буллетов ●/> строк трейса
   (.trace-prefix padding:0); правый отступ 1 сохраняем. */
.thinking-indicator { color: $deep-dim; padding: 0 1 0 0; height: 1; }
.thinking-indicator.hidden { display: none; }
/* Строка итога хода (P1b, S10): уровень 0, глиф в колонке ●, пустая
   строка сверху, тусклая. Свежая (-latest) — со сводкой правок и причиной. */
TurnLine { color: $deep-dim; padding: 0 1 0 0; margin-top: 1; height: auto; }
/* Итог за баром (S10 §3.4): строка хода и маркер /compact скрыты, пока
   стоит бар индикатора. */
TurnLine.-held, CompactionRule.-held { display: none; }

/* StreamBlock — эфемерный in-progress поток текущего шага (chat_completions) */
/* левый padding 0 — выравнивание с индикатором и колонкой буллетов трейса. */
.stream-block { color: $ink; padding: 0 1 0 0; margin-top: 1; }
.stream-block-think { color: $muted; text-style: italic; }

/* Палитра команд (overlay, Task 3.3) */
.palette       { background: $overlay-bg; border: round $run-color; height: auto; max-height: 80%; }
/* nowrap+ellipsis — канон .onb-mcp-row/.set-rowtext и одновременно инвариант
   геометрии: desired_height палитры считает ОДНУ строку на команду, и перенос
   длинного описания на вторую строку делал фактическую высоту больше заявленной —
   main.py отдавал трейсу лишнее место, нижняя рамка и футер уезжали за экран. */
.palette-row   { color: $ink; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; }
/* $list-select-bg, не $band-bg: фон оверлея (#161A23) почти совпадает с $band-bg —
   выделение было слепым; list-select-bg заметно светлее. */
.palette-row.selected { background: $list-select-bg; color: $bright; }
/* Строки скиллов (P5 §3.1): имя голубым и на выделении; хвост «пак · описание»
   серым — стилем текста строки. «… ещё N» — невыбираемая серая строка.
   Шапка пакета в пикере /skill — невыбираемая строка, чуть светлее. */
.palette-row.palette-skill-row { color: $skill; }
.palette-skill-more { color: $dim; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; }
.palette-pack-head { color: $note-ink; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; }
.palette-hint  { color: $deep-dim; padding: 0 1; }
.palette-keys  { margin-top: 1; }   /* воздух перед строкой клавиш — как .set-hint */

/* Toggle-подвал палитры (/gate, /answers — спека 2026-07-16 §4): докнут вне скролла. */
.palette-footer     { dock: bottom; height: auto; }
.palette-separator, .palette-group-sep { color: $deep-dim; padding: 0 1; height: 1; margin: 0; }

/* HelpScreen: блоки с разделителями; колонки «команда | пояснение» рядом */
.help-section {
    color: $accent;
    text-style: bold;
    padding: 0 1;
    height: 1;
}
.help-row {
    height: auto;
    width: 1fr;
    color: $ink;
    padding: 0 1;
}
/* Зебра: полоса заметно светлее фона ($bg #0E1119) — на #181c26 разница почти
   не читалась; светлее $band-bg, но темнее выделения строки. */
.help-row.help-row-alt { background: $zebra-bg; }
/* Фиксированная левая колонка — глаза не бегают через весь терминал */
.help-row-cmd {
    width: 18;
    color: $ink;
    text-style: bold;
    padding-left: 1;
}
.help-row-desc {
    width: 1fr;
    color: $dim;
    padding-left: 1;
    padding-right: 1;
}
/* Хоткей команды — своей колонкой справа (в хвосте описаний он вставал лесенкой) */
.help-row-key {
    width: 13;
    color: $deep-dim;
    padding-right: 1;
}

/* Тело ViewerScreen — read-only payload/файл */
.viewer-body   { color: $ink; padding: 0 1; }
/* FileViewerScreen: TextArea(read_only) — скролл, syntax, мышиное выделение */
FileViewerScreen #root { height: 1fr; }
#file-view-body {
    height: 1fr;
    width: 1fr;
    border: none;
    padding: 0 1;
    background: $bg;
    color: $ink;
}
#file-view-body:focus { border: none; }

/* CopyBufferScreen: TextArea на весь экран — шапка+футер как у ViewerScreen,
 * рамка — тихая палитровая (не дефолт Textual), акцент при фокусе. */
CopyBufferScreen #root { height: 1fr; }
#buffer_text {
    height: 1fr;
    width: 1fr;
    border: solid $deep-dim;
    padding: 0 1;
    background: $bg;
    color: $ink;
}
#buffer_text:focus { border: solid $accent; }

/* Строки списков (TasksScreen, SkillsScreen) */
.list-row      { color: $ink; padding: 0 1; }

/* Рамка тела экранов изменений (Р16). Именно border, а не outline: outline в
   Textual места не резервирует и рисуется ПОВЕРХ контента — первая и последняя
   строки тела оказывались съедены (замер: тот же контент даёт высоту 3 с
   outline и 5 с border). Высоту рамка занимает ВСЮ доступную (#trace и так
   1fr), а не обнимает содержимое: при смене источника и разном числе файлов
   рамка «по содержимому» прыгала бы, а экран обязан стоять на месте. Паддинга
   у тела в рамке нет — воздух слева даёт padding самих строк, и подсветка
   выбранной строки доходит до рамки, а не обрывается за колонку до неё. */
DiffScreen #trace, DiffFileViewer #trace, RevertConfirmScreen #trace {
    border: round $accent;
    padding: 0;
}

/* Строка под плашку результата (Д8 второго смоука). Плашка (`#diff-flash`)
   живёт между телом и подсказками, и без резерва она липла к полосе
   вплотную. Строка держится ВСЕГДА — и с плашкой, и без неё: полоса под
   рукой пользователя не имеет права дёргаться от появления акка. Отступ
   задан ОДНИМ shorthand-правилом: `margin-*` разных правил в Textual
   затирается целиком, а не складывается, — общий `#footer` своего margin не
   объявляет вовсе, и это правило остаётся единственным владельцем отступа
   полосы на экранах правок. */
DiffScreen #footer, DiffFileViewer #footer { margin: 1 0 0 0; }

/* Строка экрана изменений (/diff). Свой класс, а не .list-row: у того правила
   .selected нет вовсе, и выбор был бы виден только глифом. Фон выбранной — тот
   же $list-select-bg, что у палитры и .set-row (§16).
   nowrap/ellipsis — как у карточек #sessions-list и #skills-list: строку решают
   именно эти правила (Static рендерится через Content, и overflow самого
   rich.Text не доезжает), а перенос сломал бы и сетку колонок, и шаг страницы.
   Подсветки при наведении нет — как у всех списков базы. */
.diff-row          { color: $ink; padding: 0 1;
                     text-wrap: nowrap; text-overflow: ellipsis; }
.diff-row.selected { background: $list-select-bg; color: $bright; }

/* Строка группы «принято» (§4.2 волны 4) — воздух над ней отделяет её от
   активных строк списка, как в согласованном на дизайн-гейде макете; строки
   ВНУТРИ раскрытой группы садятся друг под другом без зазора — margin только
   у самой строки группы, не у `.diff-row` вообще (ловушка §Global Constraints:
   margin разных правил на одном классе затирается целиком, не суммируется). */
.diff-group-row { margin-top: 1; }

/* Блок тела вьюера изменений. Своих цветов у него нет: колонку номеров,
   заливку и подсветку рисует движок render_hunks — тот же, что у блоков
   правок в трейсе. CSS отвечает за одно — длинная строка кода режется, а не
   переносится: перенос сдвинул бы номера строк и разорвал заливку. */
/* Ширина ПО СОДЕРЖИМОМУ, а не по контейнеру: только так участок выходит за
   правый край, и полотно получает прокрутку вбок (`LazyBody`). Рваного края у
   участков не будет — заливка считается по всему телу файла сразу, поэтому
   ширина у них общая и не меньше кадра. */
.diff-hunk { width: auto; height: auto;
             text-wrap: nowrap; text-overflow: clip; }

/* Курсор по правкам во вьюере (Р18) — акцентная кромка слева, тот же приём,
   которым база метит реплики пользователя и выбранные карточки списков.
   Цвета самого диффа не трогаются: правка помечена рядом с телом, а не поверх
   него. Колонку под кромку резервирует КАЖДЫЙ участок тела (кромка цвета фона
   невидима) — иначе правка под курсором съезжала бы на колонку вправо
   относительно соседних, как съезжали кружки ●/○ в секциях настроек. */
.diff-part        { border-left: outer $bg; padding-left: 1; }
.diff-part.cursor { border-left: outer $accent; }

/* Тело подтверждения отката — тот же воздух слева, что и у участков вьюера.
   Своё правило нужно потому, что паддинг `#trace` на экранах изменений снят
   рамкой (Р16), и без него превью прилипало к рамке (`│35  line35`). Ширину
   заливки экран считает по этой же колонке — иначе она вылезла бы под
   скроллбар. */
RevertConfirmScreen #trace > Static { padding-left: 2; }

/* Дерево подтверждения (Е3 батча 3): имя блока и вложенные строки. Курсора нет,
   полос нет; `.line-meta` носит margin-top — здесь он гасится shorthand'ом. */
RevertConfirmScreen #trace > .tree-head { color: $ink;      margin: 0; padding: 0 0 0 2; }
RevertConfirmScreen #trace > .tree-line { color: $deep-dim; margin: 0; padding: 0 0 0 4; }
RevertConfirmScreen #trace > .tree-sub  { color: $deep-dim; margin: 0; padding: 0 0 0 6; }
RevertConfirmScreen #trace > .tree-warn { background: $band-bg; border-left: outer $warn; color: $warn; margin: 0; padding: 0 1 0 3; }
RevertConfirmScreen #trace > .tree-gap  { height: 1; margin: 0; padding: 0; }

/* ask_human banner (§3.4) — янтарный тон (как running), сигнал «жду тебя».
 * max-height: длинный вопрос скроллится внутри (VerticalScroll), не выдавливает
 * input/footer. Точный потолок дополнительно ставит _sync_chrome_caps. */
.ask-human-banner {
    background: $overlay-bg;
    border: round $run-color;
    padding: 0 1;
    margin: 0 1;
    height: auto;
    max-height: 50%;
    width: 1fr;
}
.ah-label { color: $bright; text-style: bold; }
.ah-body  { color: $ink; }
/* input в режиме ask_human — янтарная рамка (как баннер / running) */
TextArea.ask-human-mode { border: solid $run-color; }

/* confirm banner — служебный/security, бирюзовый (accent) вместо янтарного.
 * Тело (.cb-body) скроллится; .cb-options dock:bottom — Y/O/N/T всегда видны.
 * При cap main.py ставит height=cap (needs_height_when_capped): одного max_height
 * мало — Textual клипает box, а undocked-дети layout'ятся полной высотой. */
.confirm-banner {
    background: $overlay-bg;
    border: round $accent;
    padding: 0 1;
    margin: 0 1;
    height: auto;
    width: 1fr;
    layout: vertical;
    overflow-y: hidden;
}
.confirm-banner > .cb-body {
    height: 1fr;
    width: 1fr;
    scrollbar-size-vertical: 1;
}
.cb-label    { color: $bright; text-style: bold; height: auto; }
.cb-question { color: $ink; height: auto; }
.cb-field    { color: $dim; height: auto; }
.cb-payload  { color: $bright; text-style: bold; height: auto; }
.cb-options  {
    dock: bottom;
    color: $accent;
    height: auto;
    min-height: 5;       /* padding-top + 4 choice rows */
    padding-top: 1;
    background: $overlay-bg;
    width: 100%;
}

/* скрытый input-row при confirm (одиночные клавиши y/N без TextArea) */
#input-row.hidden { display: none; }

/* SessionsScreen — picker недавних задач (Task 4.1) */
#sessions-root { height: 100%; }
#sessions-header { height: 2; background: $overlay-bg; color: $deep-dim;
                 border-bottom: solid $deep-dim; padding: 0 1; }
#sessions-header-left  { width: 1fr; color: $deep-dim; }
#sessions-header-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }
/* Высота — auto с полом в строку, по тому же правилу, что и `#footer`: подсказки
   picker'а самые длинные в базе и не влезают в строку даже на 120 колонках. */
#sessions-footer { height: auto; min-height: 1; padding: 0 1; }
#sessions-footer-left  { width: 1fr; color: $dim; }
#sessions-footer-right { width: auto; color: $deep-dim; text-align: right; padding-right: 1; }
#sessions-list { height: 1fr; }
#sessions-list Static { padding: 0 1; }
#sessions-list .card { height: auto; margin-bottom: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#sessions-list .card.selected { background: $card-select-bg; border-left: outer $accent; }

/* PreviewScreen — read-only превью сессии (футер с линией-разделителем) */
#preview-footer { height: 2; background: $overlay-bg; color: $dim;
                  border-top: solid $deep-dim; padding: 0 1; }

/* SkillsScreen — picker, двустрочные карточки (2026-06-02) */
#skills-root { height: 100%; }
#skills-filter-row { height: 3; width: 1fr; padding: 0; background: $bg; border-top: solid $deep-dim; border-bottom: solid $deep-dim; }
#skills-filter-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left middle; padding: 0; }
#skills-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
#skills-filter:focus { border: none; }
#skills-list { height: 1fr; }
#skills-list Static { padding: 0 1; }
#skills-list .card { height: auto; margin-bottom: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#skills-list .card.selected { background: $card-select-bg; border-left: outer $accent; }

/* McpScreen — карточки серверов (spec 2026-06-10) */
.mcp-card { height: auto; padding: 0 1; margin-bottom: 1; }
.mcp-card:focus { background: $card-select-bg; border-left: outer $accent; }
.mcp-summary { padding: 0 1; }
.mcp-confirm { background: $band-bg; border-left: outer $warn; padding: 0 1; }
.mcp-row { width: 1fr; text-wrap: nowrap; text-overflow: ellipsis; }   /* описание обрезается … */
.mcp-row-managed.selected, .mcp-action-row.selected { background: $list-select-bg; }   /* контраст как у палитры */

/* ConfigScreen — fieldset-панели (spec 2026-06-10) */
.config-caption { color: $dim; padding: 0 1; margin: 0 0 1 0; }
.config-panel {
    height: auto;
    border: round $deep-dim;
    border-title-color: $dim;
    border-subtitle-color: $deep-dim;
    padding: 0 1;
    margin: 0 0 1 0;
}
/* План режима plan в ленте: рамка с подписью по образцу .config-panel,
   подпись — цветом пилюли plan. */
.plan-panel {
    height: auto;
    border: round $deep-dim;
    border-title-color: $accent;
    padding: 0 1;
    margin: 1 0 0 0;
}
/* строка «план утверждён»: галочка цвета режима plan, текст — как у line-meta */
.line-plan-accepted .trace-prefix { color: $accent; }
/* план принят, идёт реализация — рамка цвета режима plan */
.plan-panel.plan-accepted { border: round $accent; }
/* read-only вьюверы: фокус-outline бессмыслен (фокусироваться больше не на чем)
   и рисуется поверх контента */
#trace.quiet-focus:focus { outline: none; }
/* строка фильтра ключей конфига — в той же конвенции, что #skills-filter */
#config-filter-row { height: 3; width: 1fr; padding: 0; background: $bg; border-top: solid $deep-dim; border-bottom: solid $deep-dim; }
#config-filter-prompt { width: 2; color: $accent; height: 1; background: $bg; content-align: left middle; padding: 0; }
#config-filter { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }

/* ── Онбординг ─────────────────────────────────────────── */
/* Хедер (титул) сверху + футер (подсказки, слева) снизу — как на основном экране;
   teal-карточка (лого+тэглайн+степпер+шаг) — контент между ними, по размеру. */
#onb-header { height: 2; background: $bg; color: $deep-dim; padding: 0 1; border-bottom: solid $deep-dim; }
#header-left { width: 1fr; color: $deep-dim; }
/* Рамка живёт на САМОЙ области прокрутки (Р19): высота `auto` с потолком из
   кода (`form_frame.cap_frame_height` = экран минус хром) — значит все
   четыре грани нарисованы при любом размере окна, скроллбар идёт ВНУТРИ рамки,
   а футер стоит ровно под нижней гранью (margin-bottom 0). Рамка на карточке
   внутри скролла росла вместе с содержимым и уезжала за нижний край: нижней
   грани не было вовсе, а скроллбар шёл снаружи, у края экрана.
   Потолок ставится кодом, а не `max-height: 100%`: процент меряется от высоты
   ВСЕГО экрана, а не от остатка, и футер выдавливало за кадр (замер: y=14 при
   высоте 12).
   Воздух сверху/снизу у карточки — `margin`, а НЕ `padding`, и это не вкусовое:
   `scroll_to_widget` в Textual переводит координаты через margin и border
   предков, но их padding не учитывает (`widget.py`, цикл по предкам). С
   паддингом вердикт проверки соединения оказывался на строку ниже кадра, и
   `scroll_visible` его туда не довозил. Паддингом остался только боковой воздух
   (по горизонтали прокрутки нет, и арифметику он не задевает); у самой рамки
   паддинга нет вовсе — иначе скроллбар отъехал бы от грани внутрь. */
#onb-scroll { height: auto; width: 1fr; border: round $accent; padding: 0;
              margin: 1 1 0 1; background: $bg; }
#onb-footer { height: 2; background: $bg; color: $dim; padding: 0 1; }
#onb-frame { height: auto; width: 1fr; padding: 0 2; margin: 1 0; background: $bg; }
#onb-logo { height: auto; padding: 0; }
#onb-tagline { height: auto; color: $deep-dim; margin-top: 1; padding: 0; }
#onb-stepper { height: auto; padding: 2 0; }
#onb-summary { height: 1; margin-bottom: 1; }   /* строка сводки — клип по краю, без переноса; воздух перед заголовком шага */
/* Плашка о деградации загрузки: абзац в 2-3 строки, и под ним обязан быть воздух —
   иначе она сливается со следующей за ней плашкой о перекрывающем слое (тоже
   абзац, тоже цветом предупреждения) в одно нечитаемое полотно. */
#onb-degraded-warn { height: auto; margin-bottom: 1; }
#onb-body { height: auto; padding: 0; margin-bottom: 1; }   /* воздух под заголовком шага (как #set-title) */
/* Поля ввода — плоские, как #config-filter (без дефолтной рамки Input, что мусорит box-символами). */
.form-field { height: 1; width: 1fr; border: none; padding: 0; background: $bg; color: $ink; }
.form-field:focus { border: none; background: $band-bg; }
.onb-option { height: auto; padding: 0 1; width: 1fr; }
/* Выбор — только фон, БЕЗ border-left: полоса сдвигала контент на 1 колонку,
   отчего кружки ●/○ в /settings-секциях съезжали друг относительно друга. */
.onb-option.selected { background: $list-select-bg; }   /* контраст как у палитры */
.onb-mcp-row { text-wrap: nowrap; text-overflow: ellipsis; }
.set-spaced { margin-bottom: 1; }   /* воздух между строками-опциями в /settings-секциях */
/* Вариант БЕЗ второй строки описания в списке, где у соседа она есть: воздух добирает
   недостающую строку, и блоки вариантов встают одинаковой высоты (голосовой шаг мастера). */
.set-spaced-2 { margin-bottom: 2; }
/* Первая строка-действие: зазор сверху (от инфо-строк) И снизу (между действиями) одним
   shorthand — раздельные longhand'ы .set-gap+.set-spaced на одном элементе Textual перетирает
   (последний .set-gap обнулял margin-bottom → пропадал воздух под первым действием). */
.set-spaced-gap { margin: 1 0 1 0; }
.onb-hint { color: $deep-dim; padding: 0; }
.set-group-gap { margin-top: 1; }   /* отступ между группами секции (Адрес ↔ Авторизация) */
.onb-warn { color: $warn; padding: 0; }
#config-filter:focus { border: none; }

/* /settings — хаб настроек (визуальный контракт §2-3; идиомы = onb-*) */
#set-header { height: 2; background: $bg; color: $deep-dim; padding: 0 1; border-bottom: solid $deep-dim; }
/* Рамка — на области прокрутки, потолок из кода (Р19; разбор у #onb-scroll). */
#set-scroll { height: auto; width: 1fr; border: round $accent; padding: 0;
              margin: 1 1 0 1; background: $bg; }
#set-footer { height: 2; background: $bg; color: $dim; padding: 0 1; }
#set-frame { height: auto; width: 1fr; padding: 0 2; margin: 1 0; background: $bg; }
/* Единая левая граница контента = padding 0 1 у ВСЕХ элементов секции/меню
   (frame даёт +2, элементы +1 → всё на 3 от рамки; рассинхрон отступов был
   причиной «адрес левее / авторизация поехала»). */
#set-title { height: auto; padding: 0 1; margin-bottom: 1; }   /* воздух под заголовком */
/* Строка меню — горизонтальная раскладка: текст слева (1fr) + глиф статуса
   у правого края. Так глиф не «едет» при выборе и не липнет к значению. */
.set-menurow { height: auto; layout: horizontal; padding: 0 1; margin-bottom: 1; }
.set-menurow.selected { background: $list-select-bg; }   /* контраст как у палитры */
.set-rowtext { width: 1fr; height: auto; text-wrap: nowrap; text-overflow: ellipsis; }
.set-glyph { width: 3; height: auto; text-align: right; }
.set-row { height: auto; padding: 0 1; }
.set-row.selected { background: $list-select-bg; }   /* контраст как у палитры */
/* Разделитель групп секции «Режимы работы» (ревизия 7) — тот же приём, что .palette-group-sep. */
/* Плотность B: строки блока впритык, воздух несут ГРАНИЦЫ — разделитель/подпись
   блока отбивается сверху от чужого блока и стоит вплотную к своим строкам. */
.set-group-sep { color: $deep-dim; padding: 0 1; height: 1; margin: 1 0 0 0; }
.set-hint { color: $deep-dim; padding: 0 1; margin-top: 1; }   /* воздух перед контекст-подсказкой */
.set-info { height: auto; padding: 0 1; }   /* инфо-строки (Версия/Источник) — тот же отступ */
/* Подписи редакторов (Модель/Подключение) несут .onb-hint/.onb-warn из онбординга
   (padding 0) — в /settings выравниваем их на ту же границу 3, что заголовок и опции.
   Онбординг (#onb-frame) селектор не задевает — там своя раскладка. */
#set-frame .onb-hint, #set-frame .onb-warn { padding: 0 1; }
.set-gap { margin-top: 1; }                 /* вертикальный зазор между смысловыми группами */
.set-warnflash { color: $warn; }
.set-probe { margin-top: 1; }               /* воздух перед строкой статуса probe */
/* Строка перекрытия голосовой секции: она стоит НАД вариантами режима, поэтому
   воздух нужен с обеих сторон — иначе предупреждение слипается с первой строкой
   режима и снова читается как её свойство. Оба отступа ОДНИМ shorthand и правилом
   НИЖЕ `.set-hint`: раздельный margin-bottom рядом с её margin-top Textual
   перетирает (та же причина, что у `.set-spaced-gap` выше). */
.set-voiceoverride { margin: 1 0 1 0; }

/* Пост-апдейт (D4) — карточка по контенту, как #set-scroll (визуальный контракт §6);
   раньше сидел в #trace{height:1fr} и раскатывался на весь пустой экран. По
   контенту её держит `height: auto` области прокрутки с потолком из кода
   (Р19; разбор у #onb-scroll). */
#pu-scroll { height: auto; width: 1fr; border: round $accent; padding: 0;
             margin: 1 1 0 1; background: $bg; }
#pu-frame { height: auto; width: 1fr; padding: 0 2; margin: 1 0; background: $bg; }

/* Компактный режим рамки (`tui/form_frame.py::cap_frame_height`) — на тесных окнах
   собственная коробка скролла (граница `round` + вертикальный `padding: 1 2`, 4
   строки разом) съедала остаток экрана раньше, чем до неё доходило содержимое:
   рамка рисовалась пустой уже при остатке в 4-5 строк. Без границы и вертикального
   отступа тот же остаток достаётся содержимому целиком; горизонтальный отступ
   сохранён — левый край текста не должен прыгать при переключении режима. */
#set-scroll.frame-compact, #onb-scroll.frame-compact, #pu-scroll.frame-compact {
    border: none;
    padding: 0 1;
}
.pu-title { height: auto; padding: 0 0 1 0; border-bottom: solid $deep-dim; margin-bottom: 1; }
.pu-title.solo { padding: 0; border-bottom: none; margin-bottom: 0; }   /* нечего обновлять — линии под заголовком нет */
.post-update-hint { height: auto; color: $deep-dim; padding: 0; }
.post-update-item { height: auto; padding: 0; }
.set-confirm { background: $band-bg; border-left: outer $warn; padding: 0 1; margin-top: 1; }
.set-flash-ok   { background: $band-bg; border-left: outer $ok;   padding: 0 1; margin-top: 1; color: $ok; }
.set-flash-warn { background: $band-bg; border-left: outer $warn; padding: 0 1; margin-top: 1; color: $warn; }
/* Спокойная плашка (Р24): «так не получится», а не «сломалось». Тот же приём,
   что у двух соседок — фон полосы и левая кромка, — только цвет приглушённый и
   глифа в тексте нет: ⚠ на неприменимой клавише читался как поломка. */
.set-flash-note { background: $band-bg; border-left: outer $deep-dim; padding: 0 1; margin-top: 1; color: $dim; }
/* Отчёт операции (`_report`): плашка-блок для чтения, но НЕ тревога — бордер
   успеха, как у флэша, а не янтарный язык подтверждений. Текст остаётся
   обычным: читают содержимое, а не цвет. */
.set-report { background: $band-bg; border-left: outer $ok; padding: 0 1; margin-top: 1; }
#set-notice { margin-top: 1; }              /* отделить notice (итог install/удаления) от контента над ним */
/* Обёртка слота-синглтона (_singleton): нужна, чтобы новая плашка не столкнулась id'ом
   с ещё не отсоединённой старой. Собственной высоты не имеет — только содержимое. */
.set-slot { height: auto; width: 1fr; }
/* Поле ввода в /settings — скруглённая amber-рамка (.form-field.set-framed
   специфичнее плоского .form-field → онбординг остаётся без рамки, как принят). */
.form-field.set-framed { border: round $run-color; height: 3; width: 1fr; padding: 0 1; background: $bg; }
.form-field.set-framed:focus { border: round $run-color; background: $band-bg; }
/* Замороженное поле токена при «● без авторизации»: поле на месте, но disabled —
   рамка приглушается, чтобы читалось «не участвует». Только поля токена
   (set-muted): поля-факты голоса тоже disabled, но рамку держат прежней. Правило одной строкой:
   страж (`test_disabled_token_border_is_dimmed`) читает его построчно. */
.form-field.set-framed.set-muted:disabled { border: round $deep-dim; }
/* Placeholder говорит одно из двух, и это должно быть видно, не читая текст
   (спека 2026-08-03 §3.4): подсказка-объяснение приглушена, маска сохранённого
   значения — цветом значения. Своего правила на placeholder у нас не было вовсе,
   поэтому базовый случай тоже задан явно — иначе остался бы на дефолте Textual.
   Базовое — по ТИПУ поля, а не по классу: поле, переехавшее в группу, теряет
   set-framed (у поля адреса так и вышло) и молча проваливалось бы на дефолт, а
   «тускло» обязано быть одним токеном, иначе оппозиция с маской не читается.
   PasteInput — поля форм; фильтры вне форм (config/sessions/skills) на голом
   Input, их правило не задевает. Заодно честнеет спор: .has-saved (0,2,0)
   выигрывает у PasteInput (0,1,1) по специфичности, а не по порядку строк. */
PasteInput > .input--placeholder { color: $deep-dim; }
.has-saved > .input--placeholder { color: $ink; }
/* Выпадающие списки (языки/модели) — потолок высоты + собственный скролл:
   длинный список крутится внутри, страница не раскатывается (смок 2026-07-30);
   короткий — сжимается по контенту (height: auto). Рамка — слой-пикер, как
   палитра (смок: список читается отдельным блоком). Textual меряет height
   border-box'ом: 14 = ~12 контентных строк + рамка. Скроллбар — единый стиль
   VerticalScroll выше. */
.dropdown-scroll { height: auto; max-height: 14; border: round $run-color; }

/* Группа «поле + его список» — одна рамка на обоих (спека 2026-08-03 §3.1).
   Раньше поле и список были соседями с двумя одинаковыми рамками, и список
   читался отдельным блоком: человек не понимал, что это выпадающий список поля. */
.field-group { height: auto; width: 1fr; border: round $run-color; padding: 0; background: $bg; }
.field-group:focus-within { border: round $run-color; background: $band-bg; }
/* Отключённое поле в группе: рамку рисует группа, значит и гаснет она (спека §3.3,
   тот же $deep-dim, что у одинокого поля ниже). Селектор по классу, а не
   `:has(:disabled)`: `:has` Textual 8.2.7 не знает (VALID_PSEUDO_CLASSES) —
   признак ставит само поле, там же, где меняется disabled (PasteInput).
   ДОЛЖНО СТОЯТЬ НИЖЕ :focus-within — специфичность у них равная ((0,2,0) обе:
   псевдокласс считается за класс), и спор решает файловый порядок. Переставите
   выше — замороженная группа с фокусом внутри снова получит рабочую рамку. */
.field-group.set-disabled { border: round $deep-dim; }
/* Воздух даёт САМО поле, а не группа: с padding у группы подсветка выбранной
   строки (.onb-option.selected) не доходила до рамки — щель в колонку с каждой
   стороны. Своё padding: 0 1 у строк остаётся, поэтому текст поля и текст строк
   встают вровень, как в макете спеки §3.1.
   Воздух отмерен margin'ом, а не padding'ом: padding поля (`.form-field`) равен
   нулю, а выглядит так же: фон у группы и у поля один и тот же.
   background-tint: Input на фокусе осветляет себя сам (foreground 5%), и внутри
   одной рамки выходили две полосы разного оттенка — края от группы, середина от
   поля. По §3.3 цвет сфокусированной группы — ровно $band-bg, поэтому гасим тинт
   у поля, а не подгоняем группу под чужое магическое число. */
.field-group > .group-field { margin: 0 1; background-tint: 0%; }
/* Скролл внутри группы рамку не рисует — она одна, на контейнере. Потолок 12, а
   не 14: рамка уехала на группу, height больше не border-box списка (спека §3.3). */
.field-group > .dropdown-scroll { border: none; max-height: 12; }

/* Поле-факт (локальный режим: адрес/токен/модель сервиса) — не правится и выглядит
   приглушённо. (0,2,0) перебивает цвет плоского .form-field. */
.form-field.set-readonly { color: $deep-dim; }

/* Редакторы полей — Vertical по дефолту height:1fr и растягивают рамку;
   принудительно height:auto, чтобы рамка (#onb-frame/#set-frame) обнимала контент. */
ModelEditor, McpSectionEditor, ConnectionEditor, ModelEntryForm,
ModelsSectionEditor, VoiceEndpointEditor { height: auto; }
/* Секция «Модели»: строки реестра — те же .set-row, что у «Профилей»/«Режимов»
   (подсветка и отступы общие); свои классы нужны только для адресации из кода.
   Confirm-баннер удаления — язык баннера MCP (.mcp-confirm), общий с ним. */
.models-confirm { background: $band-bg; border-left: outer $warn; padding: 0 1; margin-top: 1; }
.models-picker-hint { color: $deep-dim; padding: 0 1; }
/* «запись: <полный путь>» — первая строка секции: свой воздух не нужен, отбивку
   от неё даёт margin-top первой черты-подписи (.set-group-sep). Шортхенд гасит
   margin-top базового .set-hint. nowrap: длинный путь усекается краем рамки, а не
   рвёт строку на две. */
.models-target { margin: 0; text-wrap: nowrap; }
/* Строка-якорь раскрытого пикера: без нижнего воздуха .set-spaced — список стоит
   вплотную к своей строке. Шортхенд и позиция ПОСЛЕ .set-spaced в файле: правило
   побеждает порядком при равной специфичности. */
.models-picker-anchor { margin: 0; }

/* Многострочные параметры модели используют палитру полей настроек. */
ModelEntryForm TextArea.mef-yaml {
    border: round $run-color; background: $bg; color: $ink; padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $deep-dim;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}
ModelEntryForm TextArea.mef-yaml:focus {
    border: round $run-color; background: $band-bg; color: $ink;
}

/* Подсказка с причиной у осевшей строки ошибки хода (turn_line.py). */
Tooltip { background: $overlay-bg; color: $ink; max-width: 72; }
